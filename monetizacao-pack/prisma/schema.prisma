// =====================================================================
//  MAISON SAAS — Schema multi-tenant
//  Regra de ouro: TODA tabela de negócio tem organizationId.
//  Toda query no app DEVE filtrar por organizationId (ver src/lib/tenant.ts).
//  Em produção com Supabase, ative RLS espelhando esse filtro.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------
// TENANT / PLATAFORMA
// ---------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // subdomínio: <slug>.plataforma.com.br
  logoUrl   String?
  // Identidade visual por tenant (tokens CSS)
  themeInk   String @default("#17130e")
  themeBrass String @default("#c6a15b")
  themeCream String @default("#f4efe4")
  creci     String?
  phone     String?
  email     String?
  address   String?
  city      String?
  // Self-service: credenciais do administrador do tenant
  adminEmail    String?
  panelPassHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domains       Domain[]
  users         User[]
  agents        Agent[]
  contacts      Contact[]
  properties    Property[]
  leads         Lead[]
  visits        Visit[]
  proposals     Proposal[]
  contracts     Contract[]
  commissions   Commission[]
  finance       FinanceEntry[]
  goals         Goal[]
  blogPosts     BlogPost[]
  testimonials  Testimonial[]
  subscription  Subscription?
}

// Domínio próprio por tenant (ex.: www.maisonestate.com.br)
model Domain {
  id             String       @id @default(cuid())
  host           String       @unique
  isPrimary      Boolean      @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Assinatura da imobiliária na plataforma (Stripe)
model Subscription {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                 Plan         @default(STARTER)
  status               SubStatus    @default(TRIALING)
  stripeCustomerId     String?      @unique
  stripeSubscriptionId String?      @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime     @default(now())
}

enum Plan {
  STARTER    // Start   R$149 — site + anúncios
  PRO        // Pro     R$349 — + CRM/ERP completo (⭐ âncora)
  BUSINESS   // Business R$699 — ilimitado + automações + API
  ENTERPRISE // Sob consulta
}

enum SubStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

// ---------------------------------------------------------------------
// PESSOAS
// ---------------------------------------------------------------------

// Usuário autenticável (Better Auth gerencia sessões/contas;
// esta tabela guarda o vínculo com o tenant e o papel).
model User {
  id             String       @id @default(cuid())
  email          String
  name           String?
  role           Role         @default(AGENT)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent          Agent?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, email])
  @@index([organizationId])
}

enum Role {
  PLATFORM_ADMIN // dono do SaaS
  ORG_ADMIN      // dono da imobiliária
  MANAGER        // gerente comercial
  AGENT          // corretor
  CLIENT         // portal do cliente
  OWNER          // portal do proprietário
}

// Perfil comercial do corretor
model Agent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?      @unique
  user           User?        @relation(fields: [userId], references: [id])
  name           String
  creci          String?
  phone          String?
  email          String?
  photoUrl       String?
  bio            String?
  commissionPct  Decimal      @default(2.5) @db.Decimal(5, 2) // % padrão sobre venda
  isFeatured     Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  properties  Property[]
  leads       Lead[]
  visits      Visit[]
  commissions Commission[]
  goals       Goal[]

  @@index([organizationId])
}

// Cliente, proprietário ou ambos — pessoa de contato
model Contact {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           ContactKind  @default(BUYER)
  name           String
  phone          String?
  email          String?
  document       String?      // CPF/CNPJ — LGPD: minimize e proteja
  notes          String?
  createdAt      DateTime     @default(now())

  ownedProperties Property[] @relation("PropertyOwner")
  leads           Lead[]
  visits          Visit[]
  proposals       Proposal[]
  favorites       Favorite[]

  @@index([organizationId])
  @@index([organizationId, phone])
}

enum ContactKind {
  BUYER
  OWNER
  BOTH
}

// ---------------------------------------------------------------------
// IMÓVEIS
// ---------------------------------------------------------------------

model Property {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slug           String       // URL amigável: /imovel/casa-do-vale
  title          String
  description    String?
  type           PropertyType
  status         PropStatus   @default(FOR_SALE)
  price          Decimal      @db.Decimal(14, 2)
  condoFee       Decimal?     @db.Decimal(12, 2)
  iptuYearly     Decimal?     @db.Decimal(12, 2)

  // Localização (endereço completo NÃO é exibido no site público)
  neighborhood String?
  city         String?
  state        String?  @default("SP")
  zipcode      String?
  address      String?
  latitude     Float?
  longitude    Float?

  bedrooms      Int?
  bathrooms     Int?
  suites        Int?
  parkingSpaces Int?
  areaM2        Int?
  features      String[] // diferenciais

  ownerId String?
  owner   Contact? @relation("PropertyOwner", fields: [ownerId], references: [id])
  agentId String?
  agent   Agent?   @relation(fields: [agentId], references: [id])

  commissionPct Decimal? @db.Decimal(5, 2) // sobrepõe a % do corretor se definida
  isFeatured    Boolean  @default(false)
  publishedAt   DateTime?

  // SEO por imóvel
  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media     PropertyMedia[]
  documents Document[]
  leads     Lead[]
  visits    Visit[]
  proposals Proposal[]
  favorites Favorite[]
  history   PropertyEvent[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([organizationId, city, neighborhood])
  @@index([organizationId, price])
}

enum PropertyType {
  HOUSE
  APARTMENT
  LAND
  COMMERCIAL
  FARM
}

enum PropStatus {
  DRAFT
  FOR_SALE
  EXCLUSIVE
  RESERVED
  SOLD
  ARCHIVED
}

// Fotos, vídeos, drone e tour virtual
model PropertyMedia {
  id         String    @id @default(cuid())
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  kind       MediaKind @default(PHOTO)
  url        String    // Cloudinary / Supabase Storage
  caption    String?
  sortOrder  Int       @default(0)

  @@index([propertyId, sortOrder])
}

enum MediaKind {
  PHOTO
  VIDEO
  DRONE
  VIRTUAL_TOUR // URL de embed (Matterport, Kuula...)
  FLOORPLAN
}

// A "pasta" do imóvel: escritura, matrícula, IPTU, contrato...
model Document {
  id         String   @id @default(cuid())
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  kind       DocKind
  name       String
  fileUrl    String   // storage privado + URL assinada, NUNCA público
  uploadedAt DateTime @default(now())

  @@index([propertyId])
  @@index([contractId])
}

enum DocKind {
  ESCRITURA
  MATRICULA
  IPTU
  CONTRATO
  PROCURACAO
  LAUDO
  OUTRO
}

// Linha do tempo do imóvel (alterações de preço, status etc.)
model PropertyEvent {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type       String   // "price_change" | "status_change" | "note" | ...
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([propertyId, createdAt])
}

model Favorite {
  id         String   @id @default(cuid())
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([contactId, propertyId])
}

// ---------------------------------------------------------------------
// CRM — FUNIL COMERCIAL
// ---------------------------------------------------------------------

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id])
  propertyId     String?
  property       Property?    @relation(fields: [propertyId], references: [id])
  agentId        String?
  agent          Agent?       @relation(fields: [agentId], references: [id])
  source         LeadSource   @default(SITE)
  stage          LeadStage    @default(NEW)
  score          Int          @default(0) // qualificação (IA/regras)
  budgetMax      Decimal?     @db.Decimal(14, 2)
  interest       String?      // "casa até 900 mil em Curitiba"
  lostReason     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  activities Activity[]
  visits     Visit[]
  proposals  Proposal[]

  @@index([organizationId, stage])
  @@index([organizationId, agentId, stage])
  @@index([organizationId, createdAt])
}

enum LeadSource {
  SITE
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  GOOGLE
  INDICACAO
  PORTAL // ZAP, VivaReal...
  OUTRO
}

enum LeadStage {
  NEW          // entrou
  CONTACTED    // recebeu WhatsApp/ligação
  VISIT        // visita marcada/feita
  PROPOSAL     // proposta enviada
  FINANCING    // aguardando financiamento
  CONTRACT     // contrato aguardando assinatura
  WON
  LOST
}

// Timeline do lead — o fluxo "Douglas": cada passo vira uma Activity
model Activity {
  id        String       @id @default(cuid())
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      ActivityType
  payload   Json?        // {"message": "...", "channel": "whatsapp"}
  createdAt DateTime     @default(now())

  @@index([leadId, createdAt])
}

enum ActivityType {
  PAGE_VIEW      // clicou no imóvel A
  FORM_SUBMIT    // pediu atendimento
  WHATSAPP_SENT
  WHATSAPP_RECEIVED
  EMAIL_SENT
  CALL
  NOTE
  STAGE_CHANGE
}

model Visit {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id])
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id])
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id])
  agentId        String?
  agent          Agent?       @relation(fields: [agentId], references: [id])
  scheduledAt    DateTime
  status         VisitStatus  @default(SCHEDULED)
  feedback       String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, scheduledAt])
  @@index([organizationId, agentId, scheduledAt])
}

enum VisitStatus {
  SCHEDULED
  DONE
  NO_SHOW
  CANCELED
}

model Proposal {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property       @relation(fields: [propertyId], references: [id])
  leadId         String?
  lead           Lead?          @relation(fields: [leadId], references: [id])
  contactId      String
  contact        Contact        @relation(fields: [contactId], references: [id])
  amount         Decimal        @db.Decimal(14, 2)
  conditions     String?        // "financiado 70%, FGTS..."
  status         ProposalStatus @default(SENT)
  createdAt      DateTime       @default(now())
  respondedAt    DateTime?

  contract Contract?

  @@index([organizationId, status])
}

enum ProposalStatus {
  SENT
  COUNTER
  ACCEPTED
  REJECTED
  EXPIRED
}

model Contract {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposalId     String         @unique
  proposal       Proposal       @relation(fields: [proposalId], references: [id])
  status         ContractStatus @default(AWAITING_SIGNATURE)
  totalAmount    Decimal        @db.Decimal(14, 2)
  signedAt       DateTime?
  closedAt       DateTime?
  createdAt      DateTime       @default(now())

  documents   Document[]
  commissions Commission[]
  finance     FinanceEntry[]

  @@index([organizationId, status])
}

enum ContractStatus {
  AWAITING_SIGNATURE
  SIGNED
  FINANCING
  CLOSED    // escriturado — venda concluída
  CANCELED
}

// ---------------------------------------------------------------------
// FINANCEIRO
// ---------------------------------------------------------------------

model Commission {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contractId     String
  contract       Contract         @relation(fields: [contractId], references: [id])
  agentId        String
  agent          Agent            @relation(fields: [agentId], references: [id])
  amount         Decimal          @db.Decimal(12, 2)
  status         CommissionStatus @default(PENDING)
  paidAt         DateTime?

  @@index([organizationId, agentId, status])
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELED
}

// Fluxo de caixa: entradas, saídas, impostos, pró-labore, despesas
model FinanceEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contractId     String?
  contract       Contract?    @relation(fields: [contractId], references: [id])
  direction      FlowDir
  category       FinCategory
  description    String
  amount         Decimal      @db.Decimal(14, 2)
  dueDate        DateTime
  paidAt         DateTime?

  @@index([organizationId, dueDate])
  @@index([organizationId, direction, category])
}

enum FlowDir {
  IN
  OUT
}

enum FinCategory {
  COMISSAO_RECEBIDA
  COMISSAO_PAGA
  IMPOSTO
  PRO_LABORE
  DESPESA_FIXA
  DESPESA_VARIAVEL
  MARKETING
  RECEITA_OUTRA
}

// Metas por corretor ou da organização (agentId nulo = meta da casa)
model Goal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String?
  agent          Agent?       @relation(fields: [agentId], references: [id])
  year           Int
  month          Int
  targetAmount   Decimal      @db.Decimal(14, 2)

  @@unique([organizationId, agentId, year, month])
}

// ---------------------------------------------------------------------
// CONTEÚDO DO SITE
// ---------------------------------------------------------------------

model BlogPost {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slug           String
  title          String
  excerpt        String?
  content        String
  coverImage     String?
  author         String?
  tags           String[]
  published      Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, slug])
  @@index([organizationId, published, createdAt])
}

model Testimonial {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  text           String
  author         String
  context        String?
  rating         Int          @default(5)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}
