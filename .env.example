# ===== SUPABASE (obrigatório para dados reais) =====
# Dashboard -> Settings -> Database -> Connection string -> URI
# DATABASE_URL usa a porta 6543 (pooler); DIRECT_URL usa a 5432
DATABASE_URL="postgresql://postgres.XXXX:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.XXXX:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ===== PLATAFORMA =====
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# ===== PROTEÇÃO DO PAINEL (/painel) =====
PAINEL_USER="admin"
PAINEL_PASS="troque-esta-senha"

# ===== UPLOAD DE FOTOS (opcional — Cloudinary, plano free) =====
# cloudinary.com -> Dashboard -> Cloud name
# Settings -> Upload -> Add upload preset -> Signing Mode: Unsigned
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# ===== SESSÕES DO PAINEL (obrigatório em produção) =====
# Gere um valor aleatório longo, ex.: openssl rand -hex 32
AUTH_SECRET="troque-por-um-segredo-aleatorio-longo"

# ===== WHATSAPP CLOUD API (opcional — veja WHATSAPP.md) =====
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""


# ===== E-MAIL TRANSACIONAL — "esqueci minha senha" (opcional — veja EMAIL.md) =====
# Sem estas duas, o link "Esqueci minha senha" avisa que o envio não está ativo.
RESEND_API_KEY=""
MAIL_FROM="Sua Imobiliária <nao-responda@seudominio.com.br>"

# ===== DOMÍNIO PRÓPRIO POR TENANT (opcional — veja DOMINIOS.md) =====
# Sem VERCEL_API_TOKEN e VERCEL_PROJECT_ID a tela de domínio fica em modo informativo.
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""
