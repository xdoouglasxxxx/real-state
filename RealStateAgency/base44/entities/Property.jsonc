// Entidade: Imóvel
{
  "name": "Property",
  "type": "object",
  "properties": {
    "title":          { "type": "string",  "description": "Nome do imóvel" },
    "description":    { "type": "string",  "description": "Descrição completa" },
    "property_type":  { "type": "string",  "enum": ["house", "apartment", "land", "commercial"], "description": "Tipo do imóvel" },
    "status":         { "type": "string",  "enum": ["for_sale", "exclusive", "sold"], "default": "for_sale" },
    "price":          { "type": "number",  "description": "Preço em BRL" },
    "neighborhood":   { "type": "string",  "description": "Bairro / região" },
    "city":           { "type": "string",  "default": "São Paulo" },
    "address":        { "type": "string",  "description": "Endereço (não exibido publicamente)" },
    "bedrooms":       { "type": "number" },
    "bathrooms":      { "type": "number" },
    "area_m2":        { "type": "number",  "description": "Área útil em m²" },
    "parking_spaces": { "type": "number" },
    "features":       { "type": "array",   "items": { "type": "string" }, "description": "Diferenciais" },
    "images":         { "type": "array",   "items": { "type": "string" }, "description": "URLs das fotos" },
    "video_url":      { "type": "string",  "description": "URL de vídeo (opcional)" },
    "is_featured":    { "type": "boolean", "default": false, "description": "Aparece na home" }
  },
  "required": ["title", "price", "property_type"]
}
