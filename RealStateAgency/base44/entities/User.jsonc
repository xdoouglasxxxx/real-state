// Entidade: Usuário (gerenciada pelo Base44 — campos extras opcionais)
{
  "name": "User",
  "type": "object",
  "properties": {
    "full_name": { "type": "string" },
    "email":     { "type": "string", "format": "email" },
    "role":      { "type": "string", "enum": ["admin", "agent", "viewer"], "default": "viewer" },
    "phone":     { "type": "string" }
  },
  "required": ["email"]
}
