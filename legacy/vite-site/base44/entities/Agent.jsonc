// Entidade: Corretor / Consultor
{
  "name": "Agent",
  "type": "object",
  "properties": {
    "name":        { "type": "string" },
    "role":        { "type": "string", "description": "Cargo, ex.: Diretora, Especialista em alto padrão" },
    "creci":       { "type": "string", "description": "Registro CRECI" },
    "phone":       { "type": "string" },
    "email":       { "type": "string", "format": "email" },
    "photo":       { "type": "string", "description": "URL da foto" },
    "bio":         { "type": "string" },
    "is_featured": { "type": "boolean", "default": false, "description": "Aparece na home" }
  },
  "required": ["name"]
}
