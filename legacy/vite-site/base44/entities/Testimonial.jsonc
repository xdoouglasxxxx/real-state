// Entidade: Depoimento de cliente
{
  "name": "Testimonial",
  "type": "object",
  "properties": {
    "text":    { "type": "string",  "description": "Depoimento" },
    "author":  { "type": "string",  "description": "Nome do cliente" },
    "context": { "type": "string",  "description": "Ex.: Comprou nos Jardins" },
    "rating":  { "type": "number",  "minimum": 1, "maximum": 5, "default": 5 }
  },
  "required": ["text", "author"]
}
